        (
            ids: [3],
            name: "Improve Concentration",
            kind: PersistentGlow,
            source: "procedural addition, documented: official client has no persistent Concentration glow; shared effect textures",
            ground_texture: "effect\\whitelight.tga",
            ring_texture: "effect\\lens1.tga",
            body_frames: ["effect\\lens2.tga", "effect\\lens1.tga"],
            body_glow_texture: "effect\\whitelight.tga",
            ground_color: (0.5, 0.8, 1.0),
            body_color: (0.55, 0.85, 1.0),
            glow_color: (0.8, 0.95, 1.0),
            ground_radius: 8.5,
            ring_radius: 5.5,
            body_size: 20.0,
            body_glow_size: 12.0,
            ground_alpha: 0.28,
            ring_alpha: 0.4,
            body_alpha: 0.38,
            body_glow_alpha: 0.3,
            body_frame_rate: 5.0,
            ring_rotation_speed: 0.5,
