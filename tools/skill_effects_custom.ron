        // CH_SOULCOLLECT (401): two-second self cast. The yellow `EF_BEGINSPELL`
        // cone grows for the start of the cast and the caster's body flashes
        // yellow (`EF_PORTAL5`).
        (skill: 401, phase: Cast, action: Skill, cast_circle_color: (255, 230, 160), layers: [
            (kind: Cylinder, anchor: Caster, file: "effect\\ring_yellow.tga", duration_ms: 1000, height: 8.0, bottom_radius: 2.0, top_radius: 10.0, alpha: 0.8, tint: (1.0, 0.88, 0.35), blend: Additive, grow: TopRadius),
            (kind: BodyFlash, tint: (1.0, 1.0, 0.0), hold_ms: 200, fade_ms: 600),
        ]),
