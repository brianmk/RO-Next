        ]),
        (skill: 108, phase: Success, layers: [
            (kind: Str, anchor: Auto, head: true, file: "repairweapon.str"),
        ]),
        (skill: 155, phase: Success, layers: [
            (kind: Str, anchor: Auto, head: true, file: "loud.str"),
        ]),
        (skill: 255, phase: Success, layers: [
            (kind: Str, anchor: Auto, head: true, file: "devotion.str"),
        ]),
        (skill: 256, phase: Success, layers: [
