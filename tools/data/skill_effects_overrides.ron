// Hand-written phase overrides for the unified skill effect data file.
//
// Consumed by `tools/gen_skill_effects.py --overrides` (default: this file).
// Every descriptor here **replaces** the whole (skill, phase) entry.
//
// Asura Strike (`MO_EXTREMITYFIST`, 271) has no `SKILL_EFFECT_INFO_LIST` entry;
// the original client hard-codes it (EF_BEGINASURA, 1 s, RagEffect.cpp:14187):
// two white ring waves + EF_BeginSpell.wav, the six kanji of 阿修羅覇凰拳 as
// huge dark glyphs that appear **one after another over the cast** (an instant
// cast skips them), and the impact flash. The glyph timing is therefore tied
// to the actual cast time (`cast_at` fraction), not to hard-coded delays.
(
    provenance: "hand-written replacements for official-table rows superseded by decompiled client code (rodecomp)",
    effects: [
        // AL_RUWACH (24). The 2019 effect table only carries `hitEffectId 1`
        // for it (lens1/lens2 + `ef_hit2.wav`), which the current client never
        // draws: the skill-use switch has `case AL_RUWACH: break;`
        // (`GameModePackets.cpp:21615`) and Ruwach does no damage, so the `Hit`
        // phase is unreachable. The real visual is the `EF_RUWACH` option aura
        // body (`RagEffect.cpp:23193-23232`, `EffectTypes.cpp:42`), ported as
        // `port/rag/ruwach.rs` and spawned at the `Success` phase through
        // `port/skill_map.rs`. The empty override drops the bogus row.
        (skill: 24, phase: Hit, layers: []),
        (skill: 271, phase: Cast, action: Skill, layers: [
            (kind: Cylinder, anchor: Caster, attached_entity: true, file: "effect\\ring_white.tga", duration_ms: 350, height: 2.0, bottom_radius: 6.0, top_radius: 22.0, grow: TopRadius, alpha: 0.8, blend: Additive, wav: "effect\\ef_beginspell.wav"),
            (kind: Cylinder, anchor: Caster, attached_entity: true, file: "effect\\ring_white.tga", duration_ms: 350, delay_ms: 40, height: 2.0, bottom_radius: 4.0, top_radius: 14.0, grow: TopRadius, alpha: 0.9, blend: Additive),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura1.tga", offset: (-12.0, 30.0, 0.0), size: 84.0, size_end: 96.0, duration_ms: 900, cast_at: 0.1, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura2.tga", offset: (-7.0, 24.0, 0.0), size: 88.0, size_end: 100.0, duration_ms: 900, cast_at: 0.26, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura3.tga", offset: (-2.0, 32.0, 0.0), size: 92.0, size_end: 104.0, duration_ms: 900, cast_at: 0.42, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura4.tga", offset: (3.0, 25.0, 0.0), size: 96.0, size_end: 108.0, duration_ms: 900, cast_at: 0.58, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura5.tga", offset: (8.0, 31.0, 0.0), size: 100.0, size_end: 112.0, duration_ms: 900, cast_at: 0.72, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
            (kind: Texture, anchor: Caster, attached_entity: true, file: "effect\\asura6.tga", offset: (12.0, 27.0, 0.0), size: 104.0, size_end: 116.0, duration_ms: 900, cast_at: 0.86, alpha: 0.9, tint: (0.03, 0.03, 0.03)),
        ]),
        (skill: 271, phase: Success, layers: [
            (kind: BodyFlash, tint: (1.0, 0.35, 0.05), hold_ms: 250, fade_ms: 650),
            (kind: Texture, anchor: Target, file: "effect\\alpha_center.tga", size: 14.0, size_end: 24.0, duration_ms: 500, alpha: 0.8, blend: Additive),
        ]),
        (skill: 271, phase: Hit, layers: [
            (kind: Texture, anchor: Target, attached_entity: false, file: "effect\\lens1.tga", size: 10.0, size_end: 16.0, duration_ms: 550, delay_ms: 100, count: 16, alpha: 0.8, blend: Additive, wav: "effect\\mon_아수라 패황권.wav"),
        ]),
    ],
)
