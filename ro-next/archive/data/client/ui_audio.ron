// Data-driven UI audio paths for RO-Next.
//
// Loaded through the normal game file loader (`data\client\ui_audio.ron`), so a
// server can override it inside its own archive without rebuilding the client;
// the same file is embedded with `include_str!` as the compiled fallback
// (`ro-next/src/client_config/ui_audio.rs`).
//
// Facts (hand-curated from the current client defaults, no game data was
// extracted for this file): the three paths were the constants
// `UI_BACKGROUND_MUSIC`, `MAIN_MENU_CLICK_SOUND_EFFECT` and
// `TELEPORT_VANISH_SOUND_EFFECT` in `ro-next/src/lib.rs`.
//
// Fallbacks (documented and tested):
//   * `ui_background_music: None` means the login/server/character selection
//     screens are silent instead of playing a track.
//   * A malformed archive override is logged and the compiled fallback is used.
//   * The sound effect paths must be non-empty and end in .wav/.mp3/.flac; the
//     audio engine skips a file the archives do not contain (it logs the failed
//     load), it never panics.
//
// `ro-next --check-ui-audio [PATH]` validates this file without starting a
// window.
(
    provenance: "hand-curated client defaults: lib.rs UI_BACKGROUND_MUSIC/MAIN_MENU_CLICK_SOUND_EFFECT/TELEPORT_VANISH_SOUND_EFFECT; no game data extraction",
    version: 1,
    // Background music of the screens *outside* a map (login, server and
    // character selection). `None` keeps those screens silent.
    ui_background_music: Some("bgm\\01.mp3"),
    // Interface/button click of the main menu and the other menu buttons.
    main_menu_click_sound: "버튼소리.wav",
    // Played when another entity teleports away or logs out (the classic
    // client plays it together with the teleport warp effect).
    teleport_vanish_sound: "effect\\ef_teleportation.wav",
)
