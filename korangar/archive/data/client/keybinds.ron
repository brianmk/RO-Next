// Keyboard bindings of the Korangar client.
//
// This file is shipped inside the client archive as `data\client\keybinds.ron`
// and is embedded with `include_str!` as the compiled fallback, so the archive
// override and the compiled table can never drift apart. A server can override
// it in the client archive to remap keys without rebuilding the client.
//
// The table is validated when it is loaded (and by
// `korangar --check-keybinds [PATH]`): unknown fields, unknown actions, unknown
// key names and duplicate key combinations are rejected, and a malformed
// override falls back to the compiled table with a warning instead of leaving
// the client without keyboard controls.
//
// `key` is a string with the winit `KeyCode` name (the physical key, layout
// independent), e.g. `"KeyE"`, `"Digit1"`, `"F1"`, `"Escape"`, `"Enter"`,
// `"NumpadEnter"`. Every winit `KeyCode` variant name is accepted (see
// `korangar/src/input/key_names.rs`).
//
// * `shortcuts` - window / interface actions. `modifiers` lists the modifiers
//   that have to be held (`Alt`, `Control`, `Shift`); other modifiers may be
//   held too unless `exact_modifiers: true` is set (plain `I`/`M` only fire
//   when no modifier is held, exactly like the classic client).
// * `emotion_keys` - pressed together with Alt; the position in the list is
//   the emotion number (first entry = emotion 0).
// * `hotbar_keys` - the hotbar slots; the position in the list is the slot.
// * `hotbar_tab_previous` / `hotbar_tab_next` - cycle the four hotkey tabs.
// * `chat_command_keys` - keys that confirm a focused text input (the login
//   form, the server selection and the chat command input).
//
// The defaults are the key bindings that used to be hardcoded in
// `korangar/src/input/mod.rs` (verified against integration `8a0f46da`); the
// classic-client shortcuts are kept 1:1 so existing players see no change.
(
    provenance: "Korangar default key bindings, moved out of korangar/src/input/mod.rs (classic 2019 client shortcuts; verified against integration 8a0f46da)",
    version: 1,
    shortcuts: [
        // Escape closes the topmost window, or opens the menu when no window is
        // open (and cancels an active skill target selection).
        (action: CloseOrMenu, key: "Escape"),
        // Alt window shortcuts, matching the classic client.
        (action: ToggleInventoryWindow, key: "KeyE", modifiers: [Alt]),
        (action: ToggleSkillTreeWindow, key: "KeyS", modifiers: [Alt]),
        (action: ToggleStatsWindow, key: "KeyA", modifiers: [Alt]),
        (action: ToggleFriendListWindow, key: "KeyZ", modifiers: [Alt]),
        (action: ToggleEquipmentWindow, key: "KeyQ", modifiers: [Alt]),
        (action: ToggleChatWindow, key: "KeyC", modifiers: [Alt]),
        // Ctrl settings shortcuts.
        (action: ToggleGameSettingsWindow, key: "KeyS", modifiers: [Control]),
        (action: ToggleInterfaceSettingsWindow, key: "KeyI", modifiers: [Control]),
        (action: ToggleGraphicsSettingsWindow, key: "KeyG", modifiers: [Control]),
        (action: ToggleAudioSettingsWindow, key: "KeyA", modifiers: [Control]),
        (action: ToggleShowInterface, key: "KeyH", modifiers: [Control]),
        (action: ToggleMinimapWindow, key: "KeyM", modifiers: [Control]),
        (action: CloseTopWindow, key: "KeyQ", modifiers: [Control]),
        // Plain keys are only used when no modifier is held, so they never
        // shadow the Alt/Ctrl shortcuts above or a text input.
        (action: CycleMapWindows, key: "KeyM", exact_modifiers: true),
        (action: ToggleInventoryWindow, key: "KeyI", exact_modifiers: true),
    ],
    emotion_keys: ["Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9"],
    hotbar_keys: ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"],
    hotbar_tab_previous: "F11",
    hotbar_tab_next: "F12",
    chat_command_keys: ["Enter", "NumpadEnter"],
)
