// Data-driven job/appearance registry for RO-Next.
//
// Generated by `tools/gen_jobs.py`; do not edit by hand.
// Regenerate with: `./tools/gen_jobs.py`
// Drift check:      `./tools/gen_jobs.py --check`
//
// Sources (committed facts, no game files or server tree needed to regenerate):
//   * tools/job_facts.json — generated by `tools/extract_job_facts.py` from
//     the rAthena server tree (HEAD 89c8bfa61a48310d7ebbd18992ad30b7c2631a68; `db/pre-re/skill_tree.yml`, `db/re/skill_tree.yml`, `src/common/mmo.hpp`, `src/map/pc.hpp`)
//     and the CondaRO client archives:
//     data.grf (149167 files, sha256 6dcae744fb8e5fc1…), CondaRO.grf (34565 files, sha256 813c721325d667a6…), palettes.grf (498263 files, sha256 a18d003337c6e7d0…).
//
// The job->sprite mapping is the classic client engine table (181 jobs: 
// 143 directly mapped, 1 with a verified fallback, 37 not mapped by the client).
// Every sprite/palette in this file was probed against the archives; a mapping
// whose sprite is not part of this data set always carries the fallback that is
// actually used (`source`) and the client's intended stem (`client_sprite`).
//
//
// Headgear: 1365 of 1526 accessory view ids have a sprite; 161 are documented as missing from this data set
// and are skipped by the client (accessory layers are optional).
//
// The file is loaded at runtime through the normal client file loader
// (`data\client\jobs.ron`), so a server can override the table without
// rebuilding the client. The compiled copy below is the fallback.
(
    provenance: "rAthena server tree HEAD 89c8bfa61a48310d7ebbd18992ad30b7c2631a68 (enum e_job, db/pre-re/skill_tree.yml, db/re/skill_tree.yml) + CondaRO client archives; generated by tools/gen_jobs.py from tools/job_facts.json (extracted by tools/extract_job_facts.py)",
    version: 1,
    // Classic client sprite/palette path templates.
    paths: (
        body: "인간족\\몸통\\{sex}\\{sprite}_{sex}",
        head: "인간족\\머리통\\{sex}\\{head}_{sex}",
        body_palette: "data\\palette\\몸\\{palette}_{sex}_{color}.pal",
        head_palette: "data\\palette\\머리\\머리{hair}_{sex}_{color}.pal",
        headgear: "악세사리\\{sex}\\{sex}{name}",
    ),
    sex_suffix: (
        male: "남",
        female: "여",
    ),
    appearance: (
        // Network hair style index -> client head sprite id.
        hair_styles: (
            male: [2, 2, 1, 7, 5, 4, 3, 6, 8, 9, 10, 12, 11],
            female: [2, 2, 4, 7, 1, 5, 3, 6, 12, 10, 9, 11, 8],
        ),
        // Indices accepted by the hair style lookup; bigger values are passed
        // through as sprite ids (classic client behaviour).
        hair_style_range: (start: 0, end: 12),
        // Head sprite ids that exist in this data set.
        head_range: (start: 1, end: 42),
        default_head: 1,
        default_body_palette: 0,
        default_head_palette: 0,
    ),
    // Entity classification for job ids that are not in `jobs`; the ranges are
    // the classic client job id ranges (player ids are always in `jobs`).
    entity_types: (
        warp: [45],
