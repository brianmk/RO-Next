// Paper-doll slot table of the equipment window.
//
// This file is shipped inside the client archive as
// `data\client\paper_doll_slots.ron` and is embedded with `include_str!` as the
// compiled fallback. A server can override it in the client archive to adjust
// the equipment slot layout without rebuilding the client.
//
// Every entry is one equipment slot of the paper doll:
//
// * `kind` - semantic slot kind. It maps 1:1 to the protocol `EquipPosition`
//   bitflag (`HeadTop` -> `HEAD_TOP`, `RightAccessory` -> `RIGTH_ACCESSORY`,
//   ...) used to find the equipped item and to select the localized slot
//   name/short label of `state/localization` (`PaperDollTexts`).
// * `left` / `top` - offset of the slot rectangle inside the paper-doll canvas,
//   in interface pixels at scaling 1.0 (the canvas itself is scaled by the
//   interface scaling).
//
// The canvas/slot geometry and the character fitting constants are part of the
// same table because they are the hand-tuned layout of this window. The
// defaults are exactly the values that used to be hardcoded in
// `korangar/src/interface/components/paper_doll.rs`, so the default and classic
// themes render pixel-identically at 0.75, 1.0 and 1.25 interface scaling.
//
// The table is validated when it is loaded (and by
// `korangar --check-paper-doll [PATH]`): unknown fields/kinds, duplicate slots,
// a slot count other than the 11 protocol equipment slots and slot rectangles
// outside the canvas are rejected. A malformed override falls back to the
// compiled table with a warning.
(
    provenance: "Korangar paper-doll equipment slot layout, moved out of korangar/src/interface/components/paper_doll.rs (11 equipment slots; verified against integration 8a0f46da)",
    version: 1,
    // Paper-doll canvas the slots are placed in.
    canvas_width: 220.0,
    canvas_height: 342.0,
    // Edge length of one equipment slot rectangle.
    slot_size: 42.0,
    // Maximum scale of the composited character sprite; characters with very
    // tall headgear are scaled down so no part is clipped at the top.
    character_max_scale: 3.2,
    // Space kept between the top of the character and the top of the canvas.
    character_top_margin: 6.0,
    // Equipment slots in drawing order.
    slots: [
        (kind: HeadTop, left: 89.0, top: 4.0),
        (kind: Ammo, left: 166.0, top: 4.0),
        (kind: HeadMiddle, left: 12.0, top: 52.0),
        (kind: HeadLower, left: 166.0, top: 52.0),
        (kind: Armor, left: 12.0, top: 126.0),
        (kind: Garment, left: 166.0, top: 126.0),
        (kind: RightHand, left: 12.0, top: 200.0),
        (kind: LeftHand, left: 166.0, top: 200.0),
        (kind: LeftAccessory, left: 12.0, top: 274.0),
        (kind: RightAccessory, left: 166.0, top: 274.0),
        (kind: Shoes, left: 89.0, top: 296.0),
    ],
)
